MODERA_API_KEY=
MODERA_DOCS_ENABLED=false
# MODERA_POLICY_FILE=/etc/modera/policies.json
# MODERA_MODEL_FILE=/etc/modera/models.json

# MODERA_IMAGE_ALLOWED_HOSTS=["media.example.com"]

# Use a model file or the individual selections below, not both.
# Optional classifiers: install the inference extra and prepare local weights.
# MODERA_TEXT_MODEL__ID=Horizon-Labs/multilingual-toxicity-small
# MODERA_TEXT_MODEL__REVISION=01adcc628a33848569816d4851a38544c321b92c
# MODERA_TEXT_MODEL__LABEL_MAP={"toxicity":"toxicity"}
# MODERA_IMAGE_MODEL__ID=AdamCodd/vit-base-nsfw-detector
# MODERA_IMAGE_MODEL__REVISION=8587de998f441aac03fdd57a85d2e4cb808c7d64
# MODERA_IMAGE_MODEL__LABEL_MAP={"nsfw":"sexual"}

# Optional text rules; fallback must be explicitly enabled.
# MODERA_TEXT_RULES_FILE=/etc/modera/text-rules.json
# MODERA_TEXT_FALLBACK=rules
# MODERA_TEXT_FALLBACK_POLICY=rules-only
